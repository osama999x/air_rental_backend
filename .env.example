NODE_ENV=development
PORT=3000
API_VERSION=1.0.0
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
SEED_ON_BOOT=true
RUN_JOBS_IN_API=true
UPLOAD_MAX_MB=10
STORAGE_DIR=storage/private
STORAGE_DRIVER=local

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=air_rental
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Tokens. Replace these before any shared or production environment.
JWT_SECRET=replace-with-a-long-random-string
REFRESH_KEY=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_KEY_EXPIRES_IN=2592000

# Optional identity providers. Leave blank until credentials exist.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Optional email. OTP delivery is skipped when these are blank.
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_ADDRESS=
MAIL_PASSWORD=

# Optional S3-compatible storage. The local private folder is used until these are set.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Payments. sandbox is the only adapter that can settle without a gateway.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

# Optional AI provider. Ask and extract return "not configured" until both are set.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=

# Optional push and SMS. Delivery is recorded as skipped when unset.
FCM_SERVER_KEY=
SMS_PROVIDER=
SMS_API_KEY=

# First internal admin. Used only by npm run admin:bootstrap. Never commit a real password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

SWAGGER_USER=dev
SWAGGER_PASSWORD=change-me
